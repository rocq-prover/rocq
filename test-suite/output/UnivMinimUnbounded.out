pair_box@{u u0 u1} :
forall (I : Type@{u}) (J : Type@{u0}) (G : Box@{u1}),
G = box@{max(u,u0)} (I * J) -> G = box@{max(u,u0)} (I * J)
(* u(= in 1st binder) u0(= in 2nd binder) u1(= in 3rd, 4th binders,
   = in type) |
   u ≤ u1
